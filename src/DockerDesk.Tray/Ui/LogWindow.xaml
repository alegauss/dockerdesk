<!-- One window per container, because two containers' logs in one pane is a thing to disentangle
     rather than read. The chrome is Ui/Theme.xaml's, merged at application scope (DD34), so what is
     said here is what differs: the log itself is monospace, because a stack trace that does not line
     up is a stack trace nobody reads. ThemeMode stays here because it cannot move without changing
     how the window renders — measured against a capture, see Ui/Theme.cs. -->
<Window x:Class="DockerDesk.Tray.Ui.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DockerDesk.Tray.Ui"
        x:ClassModifier="internal"
        Title="Logs"
        Width="900" Height="600"
        MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ThemeMode="System"
        FontFamily="{x:Static ui:Palette.Body}">

    <Window.Resources>
        <!-- BasedOn is load-bearing: a keyed style replaces the implicit one outright, and without
             it these fall back to the pre-Fluent chrome. It cannot move to Theme.xaml, and that was
             measured: ThemeMode puts Fluent in the WINDOW's resources, so the same BasedOn resolved at
             application scope finds the pre-Fluent Button and quietly reintroduces the trap. -->
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="Heading" FontSize="14" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Follow on by default: a log window opened on a container that is still running
                     is opened to watch it. -->
                <CheckBox x:Name="Follow" Content="Follow" IsChecked="True"
                          VerticalAlignment="Center"
                          Checked="FollowChanged" Unchecked="FollowChanged" />
                <!-- The next thing a developer does with a stack trace is paste it somewhere. -->
                <Button x:Name="CopyAll" Content="Copy all" Click="CopyEverything"
                        Style="{StaticResource Action}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" x:Name="LogPane" CornerRadius="6" Padding="2"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ListBox x:Name="Lines" BorderThickness="0" Background="Transparent"
                     FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- stderr in red, which is where a container that died two seconds in
                             usually says why. Colour and nothing else: the text is already the
                             difference, this only makes it findable by scrolling. -->
                        <TextBlock Text="{Binding Text}" TextWrapping="NoWrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{x:Static ui:Palette.DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Empty is designed here too: a container that never wrote anything and a stream that
             could not be opened are different answers, and a blank box is neither. -->
        <StackPanel Grid.Row="1" x:Name="Empty" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="EmptyHeadline" FontSize="16" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="EmptyDetail" Margin="0,6,0,0" FontSize="12" MaxWidth="440"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="Status" Margin="2,8,0,0" FontSize="12"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </Grid>
</Window>
