<!-- The one window, and it is a list of containers, because that is what the tool is opened for.
     The chrome borrows claude-tray's: ThemeMode="System" so light and dark follow the OS, the
     Fluent brushes by DynamicResource, and Segoe UI Variable — two apps by the same author that
     look unrelated read as two unfinished apps. -->
<Window x:Class="DockerDesk.Tray.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="DockerDesk"
        Width="1040" Height="560"
        MinWidth="880" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <!-- A port that is published opens in a browser; one that is only exposed is plain text.
             Same cell, two behaviours, and the difference has to be visible without a caption. -->
        <Style x:Key="PortLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,2,6,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Five visibilities on a row, each straight off a bool the row already exposes. The
             framework ships this converter; five more DataTriggers would be XAML explaining a
             boolean to itself. -->
        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- BasedOn is load-bearing, not tidiness: a keyed style replaces the implicit one outright,
             so without this the row buttons fall back to the pre-Fluent chrome and render as light
             grey rectangles on a dark window. -->
        <Style x:Key="RowAction" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The engine's own state, in words. Everything below is a view of this thing. -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="EngineDot" Width="10" Height="10" VerticalAlignment="Center" />
                <TextBlock x:Name="EngineLabel" Margin="8,0,0,0" FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
            <!-- The terms, where the choice is made. A visitor who cannot establish them in the
                 first ten seconds assumes the same trap they came here to escape. -->
            <Button Content="About" Click="ShowAbout" HorizontalAlignment="Right"
                    Style="{StaticResource RowAction}" Margin="0" />
        </Grid>

        <!-- Two tabs rather than two windows: containers and images are one question about one
             machine, and the answer to "can I delete this image" is a container in the other list. -->
        <TabControl Grid.Row="1" x:Name="Tabs" BorderThickness="0" Background="Transparent"
                    SelectionChanged="TabChanged">
          <TabItem Header="Containers">
            <Grid Margin="0,10,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="HeaderRow" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="0.7*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="1" Text="IMAGE" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="2" Text="STATE" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource Header}" />
            <TextBlock Grid.Column="4" Text="PORTS" Style="{StaticResource Header}" />
        </Grid>

        <ListView Grid.Row="1" x:Name="Containers" BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Character for character the same as HeaderRow's, and a test asserts
                                 it: a header whose columns have drifted from the rows under it puts
                                 every caption over the wrong cell, and nothing but looking at the
                                 window says so. -->
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Image}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding State}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ItemsControl Grid.Column="4" ItemsSource="{Binding Ports}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One of the two shows. A DataTrigger rather than a converter:
                                         the whole condition is IsLink, and a converter class would
                                         be a file to explain that. -->
                                    <Grid>
                                        <Button Content="{Binding Text}" Tag="{Binding Url}"
                                                Click="OpenPort" ToolTip="{Binding Url}">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource PortLink}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock Text="{Binding Text}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource PortText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLink}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The four verbs, or the one word that says the click landed. Optimistic:
                             the row goes pending on press and the event stream is what takes it
                             back out, because a stop can take the daemon's full ten seconds. -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                            <!-- First, and offered in every state including pending: the log is the
                                 one artefact a container that exited two seconds in leaves, and
                                 reading it changes nothing that could be in flight. -->
                            <Button Content="Logs" Tag="{Binding}" Click="OpenLogs"
                                    Style="{StaticResource RowAction}" />
                            <!-- The one button that is disabled rather than hidden, because
                                 "you cannot do this yet" and "this does not exist" are different
                                 answers and only the tooltip can tell them apart. -->
                            <Button Content="Shell" Tag="{Binding}" Click="OpenShell"
                                    Style="{StaticResource RowAction}"
                                    IsEnabled="{Binding CanShell}"
                                    ToolTip="{Binding ShellReason}" />
                            <Button Content="Start" Tag="{Binding}" Click="StartContainer"
                                    Style="{StaticResource RowAction}"
                                    Visibility="{Binding CanStart, Converter={StaticResource Shown}}" />
                            <Button Content="Stop" Tag="{Binding}" Click="StopContainer"
                                    Style="{StaticResource RowAction}"
                                    Visibility="{Binding CanStop, Converter={StaticResource Shown}}" />
                            <Button Content="Restart" Tag="{Binding}" Click="RestartContainer"
                                    Style="{StaticResource RowAction}"
                                    Visibility="{Binding CanRestart, Converter={StaticResource Shown}}" />
                            <Button Content="Remove" Tag="{Binding}" Click="RemoveContainer"
                                    Style="{StaticResource RowAction}"
                                    Visibility="{Binding CanRemove, Converter={StaticResource Shown}}" />
                            <TextBlock Text="{Binding Pending}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding IsPending, Converter={StaticResource Shown}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Where the click was, in the engine's own words. A port already in use or a
                         volume still mounted is an ordinary answer, and the daemon says it better
                         than any paraphrase this tool could write. -->
                    <TextBlock Text="{Binding Failure}" Margin="0,4,0,0" TextWrapping="Wrap"
                               FontSize="12" Foreground="#E5484D"
                               Visibility="{Binding HasFailure, Converter={StaticResource Shown}}" />
                  </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty is designed, not a blank grid: the two reasons a list is empty read differently,
             and only one of them is something the user can do anything about. -->
        <StackPanel Grid.Row="1" x:Name="Empty" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="EmptyHeadline" FontSize="20" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="EmptyDetail" Margin="0,8,0,0" FontSize="13"
                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button x:Name="EmptyStart" Content="Start the engine" Margin="0,18,0,0"
                    Padding="18,8" HorizontalAlignment="Center" Visibility="Collapsed"
                    Click="StartEngine" />
        </StackPanel>
            </Grid>
          </TabItem>

          <TabItem Header="Images">
            <Grid Margin="0,10,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- The total, and what prune would give back, both named before anything is clicked:
                   "are you sure" about an unknown quantity is a question nobody can answer. -->
              <Grid Grid.Row="0" Margin="10,0,10,10">
                <TextBlock x:Name="ImageTotalsLine" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock x:Name="ImageOutcome" VerticalAlignment="Center" Margin="0,0,10,0"
                             FontSize="12" TextWrapping="Wrap" MaxWidth="420"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  <!-- Dangling only. `prune -a` deletes every image no *running* container uses,
                       which on a developer's machine is most of them, and that is not a thing to
                       put one click away. -->
                  <Button x:Name="PruneImages" Content="Prune dangling" Click="PruneDangling"
                          Style="{StaticResource RowAction}" />
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" x:Name="ImageHeaderRow" Margin="10,0,10,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="0.8*" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="REPOSITORY" Style="{StaticResource Header}" />
                <TextBlock Grid.Column="1" Text="TAG" Style="{StaticResource Header}" />
                <TextBlock Grid.Column="2" Text="SIZE" Style="{StaticResource Header}" />
                <TextBlock Grid.Column="3" Text="USED BY" Style="{StaticResource Header}" />
              </Grid>

              <ListView Grid.Row="2" x:Name="Images" BorderThickness="0"
                        Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,8" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <!-- Same as ImageHeaderRow's, character for character; a test asserts it. -->
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="1*" />
                          <ColumnDefinition Width="0.8*" />
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Repository}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Tag}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <!-- The join, in one cell: what holds this image, or that nothing does. -->
                        <TextBlock Grid.Column="3" Text="{Binding Status}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                          <Button Content="Remove" Tag="{Binding}" Click="RemoveImage"
                                  Style="{StaticResource RowAction}"
                                  Visibility="{Binding IsIdle, Converter={StaticResource Shown}}" />
                          <TextBlock Text="{Binding Pending}" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                     Visibility="{Binding IsPending, Converter={StaticResource Shown}}" />
                        </StackPanel>
                      </Grid>
                      <!-- An image in use cannot be removed and the engine names the container that
                           holds it. Passed through, because that names the row to deal with first. -->
                      <TextBlock Text="{Binding Failure}" Margin="0,4,0,0" TextWrapping="Wrap"
                                 FontSize="12" Foreground="#E5484D"
                                 Visibility="{Binding HasFailure, Converter={StaticResource Shown}}" />
                    </StackPanel>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>

              <StackPanel Grid.Row="2" x:Name="ImagesEmpty" VerticalAlignment="Center"
                          HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="ImagesEmptyHeadline" FontSize="20" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="ImagesEmptyDetail" Margin="0,8,0,0" FontSize="13"
                           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </TabItem>

          <TabItem Header="Volumes">
            <Grid Margin="0,10,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="10,0,10,10">
                <TextBlock x:Name="VolumeTotalsLine" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock x:Name="VolumeOutcome" VerticalAlignment="Center" Margin="0,0,10,0"
                             FontSize="12" TextWrapping="Wrap" MaxWidth="420"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  <!-- Anonymous only. A named volume is somebody's database, and the endpoint's
                       `all=true` that would take those is not sent and not offered. -->
                  <Button x:Name="PruneVolumes" Content="Prune anonymous" Click="PruneAnonymous"
                          Style="{StaticResource RowAction}" />
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" x:Name="VolumeHeaderRow" Margin="10,0,10,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.4*" />
                  <ColumnDefinition Width="0.8*" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource Header}" />
                <TextBlock Grid.Column="1" Text="SIZE" Style="{StaticResource Header}" />
                <TextBlock Grid.Column="2" Text="MOUNTED BY" Style="{StaticResource Header}" />
              </Grid>

              <ListView Grid.Row="2" x:Name="Volumes" BorderThickness="0"
                        Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,8" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <!-- Same as VolumeHeaderRow's; a test asserts it. -->
                          <ColumnDefinition Width="2.4*" />
                          <ColumnDefinition Width="0.8*" />
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <!-- "nothing mounts it" is the row somebody is looking for. -->
                        <TextBlock Grid.Column="2" Text="{Binding Holders}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                          <Button Content="Delete" Tag="{Binding}" Click="RemoveVolume"
                                  Style="{StaticResource RowAction}"
                                  Visibility="{Binding IsIdle, Converter={StaticResource Shown}}" />
                          <TextBlock Text="{Binding Pending}" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                     Visibility="{Binding IsPending, Converter={StaticResource Shown}}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding Failure}" Margin="0,4,0,0" TextWrapping="Wrap"
                                 FontSize="12" Foreground="#E5484D"
                                 Visibility="{Binding HasFailure, Converter={StaticResource Shown}}" />
                    </StackPanel>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>

              <StackPanel Grid.Row="2" x:Name="VolumesEmpty" VerticalAlignment="Center"
                          HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="VolumesEmptyHeadline" FontSize="20" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="VolumesEmptyDetail" Margin="0,8,0,0" FontSize="13"
                           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>
    </Grid>
</Window>
